{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotificationsDb": "Host=localhost;Port=5434;Database=notifications;Username=postgres;Password=postgres"
  },
  "Notifications": {
    "Channel": "Smtp"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "no-reply@commerce-platform.local",
    "OperationsEmail": "ops@commerce-platform.local"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
