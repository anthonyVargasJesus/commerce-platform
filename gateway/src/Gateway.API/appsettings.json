{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:8180/realms/commerce",
    "Audience": "commerce-platform"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4200", "http://localhost:5173" ]
  },
  "RateLimiting": {
    "PermitLimit": 600,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "authenticated",
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/inventory/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/inventory" } ]
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "authenticated",
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/orders" } ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "authenticated",
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/notifications" } ]
      }
    },
    "Clusters": {
      "inventory": {
        "Destinations": { "primary": { "Address": "http://localhost:5254/" } }
      },
      "orders": {
        "Destinations": { "primary": { "Address": "http://localhost:5280/" } }
      },
      "notifications": {
        "Destinations": { "primary": { "Address": "http://localhost:5290/" } }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
